# Team setup: copy this file to .env and keep .env out of Git.
# Safe local-development defaults follow.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Use pglite for a real, embedded PostgreSQL-compatible local database.
# Use postgres with DATABASE_URL in hosted environments.
DATABASE_MODE=pglite
PGLITE_DATA_DIR=./.data/solvesphere
DATABASE_URL=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Local-only verification delivery. The API returns a code for automated tests;
# the browser never displays it. Use an email provider to receive real emails.
# The app refuses this mode in production.
DEV_AUTH_ENABLED=true
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=SolveSphere <onboarding@resend.dev>
# Optional HTTPS provider; takes priority over Resend when configured.
# Verify the sender in Brevo and activate transactional email before use.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BOOTSTRAP_ADMIN_EMAIL=
DEMO_DATA_ENABLED=false

# For production, set DEV_AUTH_ENABLED=false and connect your email provider
# with Brevo, Resend, or an HTTPS adapter accepting { email, code, purpose }.
# Resend's onboarding@resend.dev can only email the Resend account owner.
# Other recipients need a verified owned domain, or a verified Brevo sender.
# Render Free blocks SMTP ports; use these HTTPS APIs instead of Gmail SMTP.

# Idempotent local demo data. The app refuses this mode in production.
DEV_SEED_ENABLED=true
DEV_ADMIN_EMAIL=admin@solvesphere.local
DEV_ADMIN_PASSWORD=Admin@123

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Production checklist (replace every placeholder):
# NODE_ENV=production
# DATABASE_MODE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/solvesphere
# JWT_ACCESS_SECRET=generate-a-random-secret-with-at-least-32-characters
# CORS_ORIGINS=https://your-frontend.example
# DEV_AUTH_ENABLED=false
# DEV_SEED_ENABLED=false
# OTP_DELIVERY_WEBHOOK_URL=https://your-email-adapter.example/verification
# OTP_DELIVERY_API_KEY=your-provider-secret
# RESEND_API_KEY=your-provider-secret
# EMAIL_FROM=SolveSphere <verify@your-domain.example>
# BOOTSTRAP_ADMIN_EMAIL=verified-admin@example.com
# DEMO_DATA_ENABLED=true
# UPLOAD_DIR=/persistent/uploads
