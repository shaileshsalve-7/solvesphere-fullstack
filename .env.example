NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Use pglite for a real, embedded PostgreSQL-compatible local database.
# Use postgres with DATABASE_URL in hosted environments.
DATABASE_MODE=pglite
PGLITE_DATA_DIR=./.data/solvesphere
DATABASE_URL=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Local-only OTP delivery. The app refuses this mode in production.
DEV_AUTH_ENABLED=true
DEV_OTP_CODE=123456
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@solvesphere.local

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
